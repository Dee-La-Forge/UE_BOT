# Grammaire GBNF — contraint le format de sortie du LLM.
#
# Objectif : rendre le verdict DETERMINISTE. L'ancien systeme dependait
# du parsing des "narrative sections" renvoyees par Convai ; ici le modele
# ne PEUT PAS produire autre chose que le format attendu.
#
# Ordre voulu : le texte parle d'abord (il part au TTS immediatement),
# les tags ensuite (ils n'ont pas besoin d'etre lus a voix haute).
#
#   Bonjour. Presentez-moi vos papiers.[EMOTION:Concerned][VERDICT:EN_COURS]

root ::= replique emotion verdict

# Texte parle : tout sauf le crochet ouvrant, qui signale la fin de replique
replique ::= [^\[]+

# Aligne sur l'enum E_Emotions du plugin Convai (Motions2/Face/)
emotion ::= "[EMOTION:" ("Neutral" | "Concerned" | "Angry" | "Happy" | "Stare") "]"

# EN_COURS tant que l'entretien continue ; ACCEPTE/REFUSE declenche le tampon
verdict ::= "[VERDICT:" ("EN_COURS" | "ACCEPTE" | "REFUSE") "]"
