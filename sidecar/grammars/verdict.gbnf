# Grammaire de la phase de verdict — a partir de la 5e question repondue.
#
# Le modele peut desormais clore l'entretien. Passe le plafond de
# questions_max, le code bascule sur cloture.gbnf (voir machine_etats.py).

root ::= replique emotion verdict

# Au plus deux phrases — voir entretien.gbnf pour le detail.
# Plancher a 12 : bloque le remplissage d'un mot (« Sensible. », « coyote. »)
# tout en laissant passer une cloture seche (« Acces refuse. »).
replique ::= phrase (" " phrase)?

phrase ::= [^\[<.!?\n]{12,110} [.!?]

# Neutral et Happy reapparaissent ici : la section "accepte" demande une
# cloture "froide, breve, administrative", ce que Neutral traduit bien.
emotion ::= "[EMOTION:" ("Stare" | "Concerned" | "Angry" | "Neutral" | "Happy") "]"

verdict ::= "[VERDICT:" ("EN_COURS" | "ACCEPTE" | "REFUSE") "]"
